{
  "org": "leat-consulting",
  "permissions": {
    "enabled_repositories": "all",
    "allowed_actions": "selected",
    "sha_pinning_required": true
  },
  "selected_actions": {
    "github_owned_allowed": true,
    "verified_allowed": false,
    "patterns_allowed": [
      "leat-consulting/*",
      "docker/build-push-action@*",
      "docker/login-action@*",
      "docker/metadata-action@*",
      "docker/setup-buildx-action@*"
    ]
  }
}
