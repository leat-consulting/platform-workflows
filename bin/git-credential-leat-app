#!/usr/bin/env bash
# Git credential helper that supplies a leat-claude App installation token.
# Configure per repository:
#   git config credential.helper ""
#   git config --add credential.helper "/path/to/bin/git-credential-leat-app"
set -euo pipefail
[ "${1:-}" = "get" ] || exit 0
echo "username=x-access-token"
echo "password=$("$(dirname "$0")/gh-app-token")"
